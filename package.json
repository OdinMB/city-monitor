{
  "name": "city-monitor",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "workspaces": [
    "packages/*",
    "shared"
  ],
  "scripts": {
    "dev": "turbo dev",
    "dev:synthetic": "npm run build --workspace=shared && npm run dev:synthetic --workspace=packages/server --",
    "db:seed": "npm run build --workspace=shared && npm run db:seed --workspace=packages/server --",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "lint": "turbo lint",
    "test": "turbo test"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.4"
    },
    "satori": {
      "fflate": "^0.7.5"
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.3",
    "eslint": "^9.39.3",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "turbo": "^2",
    "typescript": "^5.7",
    "typescript-eslint": "^8.56.1"
  },
  "packageManager": "npm@10.9.0",
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  }
}
